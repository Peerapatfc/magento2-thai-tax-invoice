<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Peerapatfc\ThaiTaxInvoice\ViewModel\Adminhtml\OrderTaxInvoice $viewModel
 */
$viewModel = $block->getData('view_model');
$request = $viewModel->getRequest();
if ($request === null) {
    return;
}
$issued = $viewModel->getIssuedInvoice();
?>
<section class="admin__page-section order-tax-invoice">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Full tax invoice requested')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <table class="admin__table-secondary">
            <tbody>
            <tr>
                <th><?= $escaper->escapeHtml(__('Tax invoice number')) ?></th>
                <td>
                    <?php if ($issued): ?>
                        <strong><?= $escaper->escapeHtml($issued['number']) ?></strong>
                        (<a href="<?= $escaper->escapeUrl($issued['print_url']) ?>" target="_blank"><?=
                            $escaper->escapeHtml(__('Print')) ?></a>)
                    <?php else: ?>
                        <?= $escaper->escapeHtml(__('Not issued yet')) ?>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <th><?= $escaper->escapeHtml(__('Invoice for')) ?></th>
                <td>
                    <?= $escaper->escapeHtml($request['type'] === 'individual' ? __('Individual') : __('Company')) ?>
                </td>
            </tr>
            <tr>
                <th><?= $escaper->escapeHtml(__('Name on the invoice')) ?></th>
                <td><?= $escaper->escapeHtml($request['name']) ?></td>
            </tr>
            <tr>
                <th><?= $escaper->escapeHtml(__('Registered for VAT')) ?></th>
                <td><?= $escaper->escapeHtml($request['vat_registered'] ? __('Yes') : __('No')) ?></td>
            </tr>
            <tr>
                <th><?= $escaper->escapeHtml(__('Tax ID')) ?></th>
                <td><?= $escaper->escapeHtml($request['tax_id'] !== '' ? $request['tax_id'] : __('Not given')) ?></td>
            </tr>
            <?php if ($request['vat_registered']): ?>
            <tr>
                <th><?= $escaper->escapeHtml(__('Branch code')) ?></th>
                <td><?= $escaper->escapeHtml($request['branch']) ?></td>
            </tr>
            <?php endif; ?>
            <tr>
                <th><?= $escaper->escapeHtml(__('Address on the invoice')) ?></th>
                <td style="white-space: pre-line;"><?= $escaper->escapeHtml(
                    $request['address'] === '' ? __('The billing address of this order') : $request['address']
                ) ?></td>
            </tr>
            </tbody>
        </table>
        <?php if (!$issued && $viewModel->hasNoVat()): ?>
            <p class="message message-warning">
                <?= $escaper->escapeHtml(__(
                    'This order has no VAT. A tax invoice normally shows VAT: check the tax settings before issuing it.'
                )) ?>
            </p>
        <?php endif; ?>
    </div>
</section>
